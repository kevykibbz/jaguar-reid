# Environment Variables Template
# ====================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Azure Storage Configuration
# Get these from Azure Portal > Storage Account > Access Keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;EndpointSuffix=core.windows.net;AccountName=YOUR_STORAGE_ACCOUNT;AccountKey=YOUR_ACCESS_KEY;BlobEndpoint=https://YOUR_STORAGE_ACCOUNT.blob.core.windows.net/;FileEndpoint=https://YOUR_STORAGE_ACCOUNT.file.core.windows.net/;QueueEndpoint=https://YOUR_STORAGE_ACCOUNT.queue.core.windows.net/;TableEndpoint=https://YOUR_STORAGE_ACCOUNT.table.core.windows.net/
AZURE_STORAGE_CONTAINER=jaguar-images

# Database Configuration
# Choose either SQLite (local) or PostgreSQL (Azure/production)
DATABASE_TYPE=sqlite  # or postgresql

# For PostgreSQL (Azure Database for PostgreSQL)
# DATABASE_URL=postgresql://username:password@hostname/database?sslmode=require

# For SQLite (local development - default)
# No DATABASE_URL needed for SQLite

# Backend URL for nginx proxy in frontend container
# Local Docker: http://backend:8000 (default)
# Production Azure: https://your-backend.azurecontainerapps.io
BACKEND_URL=http://backend:8000

# Frontend Port (change if 3000 is in use)
FRONTEND_PORT=3001